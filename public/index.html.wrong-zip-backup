<script id="reel-features-js">
(function(){
  const calm=matchMedia('(prefers-reduced-motion:reduce)').matches;
  const $=id=>document.getElementById(id);
  const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
  const ease=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
  const mob=()=>innerWidth<900;

  /* ---------- kinetic words ---------- */
  function split(el){
    let i=0;
    (function walk(n){[...n.childNodes].forEach(c=>{
      if(c.nodeType===3){
        const fr=document.createDocumentFragment();
        c.textContent.split(/(\s+)/).forEach(t=>{
          if(!t)return;
          if(/^\s+$/.test(t)){fr.appendChild(document.createTextNode(' '));return}
          const w=document.createElement('span');w.className='w';
          const s=document.createElement('span');s.textContent=t;s.style.setProperty('--i',i++);
          w.appendChild(s);fr.appendChild(w);
        });
        c.replaceWith(fr);
      }else if(c.nodeType===1&&c.tagName!=='BR')walk(c);
    })})(el);
  }
  document.querySelectorAll('.st-h').forEach(split);
  if(!calm){
    const kio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('kin-in');kio.unobserve(e.target)}}),{threshold:.35});
    document.querySelectorAll('section h2,.cta h2').forEach(h=>{
      if(h.closest('.walk-title,.st,.cine'))return;
      split(h);h.classList.add('kin');kio.observe(h);
    });
  }

  /* ---------- shared scroll engine for pinned sections ---------- */
  const stages=[];let raf=0;
  function reg(sec,fn,k){stages.push({sec,fn,k:k||.14,cur:null,tgt:0})}
  function loop(){
    raf=0;let again=false;const vh=innerHeight;
    for(const s of stages){
      const r=s.sec.getBoundingClientRect();
      if(r.bottom<-vh*.3||r.top>vh*1.3)continue;
      s.tgt=clamp(-r.top/Math.max(1,s.sec.offsetHeight-vh));
      if(s.cur===null)s.cur=s.tgt;
      const d=s.tgt-s.cur;s.cur+=Math.abs(d)<.0005?d:d*s.k;
      s.fn(s.cur);
      if(Math.abs(s.tgt-s.cur)>.0005)again=true;
    }
    if(again)raf=requestAnimationFrame(loop);
  }
  const kick=()=>{if(!raf)raf=requestAnimationFrame(loop)};
  addEventListener('scroll',kick,{passive:true});addEventListener('resize',kick);
  addEventListener('load',()=>setTimeout(kick,50));

  /* ---------- 1. exploded room assembly ---------- */
  const lx=$('layers');
  if(lx){
    const stack=$('lxStack'),cap=$('lxCap'),n=$('lxn'),t=$('lxt'),d=$('lxd');
    const L=[
      ['01','Civil & flooring','The base: levelled, laid and finished with care.'],
      ['02','Walls & paint','Wall design and paint colours that set the mood.'],
      ['03','Modular interiors','Kitchens, wardrobes and storage made to fit.'],
      ['04','False ceiling & lighting','Layered light that makes the room feel warm.'],
      ['05','The finished space','Everything together, ready to live in.']
    ];
    let last=-1;
    const draw=p=>{
      const s=1-ease(clamp(p/.55)),f=ease(clamp((p-.64)/.28));
      stack.style.setProperty('--s',s.toFixed(3));stack.style.setProperty('--f',f.toFixed(3));
      lx.style.setProperty('--p',p.toFixed(3));
      const idx=Math.min(4,Math.floor(clamp(p/.6)*5));
      if(idx!==last){
        last=idx;cap.classList.add('sw');
        setTimeout(()=>{n.textContent=L[idx][0];t.textContent=L[idx][1];d.textContent=L[idx][2];cap.classList.remove('sw')},150);
      }
    };
    if(calm){lx.style.height='auto';draw(.9)}else reg(lx,draw,.12);
  }

  /* ---------- 2. 3D photo ribbon ---------- */
  const rb=$('ribbon');
  if(rb){
    const R=[['A','Interior','Living space'],['K','Bedroom','Bedroom'],['I','Interior','Full home'],['J','Modular kitchen','Material & detail'],['F','Interior detail','Design details'],['B','Interior','Living space'],['L','Interior','Living space'],['H','Lounge','Lounge'],['G','Kitchen detail','Kitchen'],['D','Interior','Bedroom']];
    const stage=$('rbStage'),n=$('rbn'),t=$('rbt'),s2=$('rbs');
    const cards=R.map(r=>{
      const f=document.createElement('figure');f.className='rb-c';
      const im=document.createElement('img');im.alt=r[1];im.decoding='async';im.loading='lazy';im.src=IMG[r[0]]||FALLBACK;
      f.appendChild(im);stage.appendChild(f);return f;
    });
    let lastI=-1;
    const draw=p=>{
      const N=cards.length,pos=-1.1+p*(N-1+2.2),m=mob();
      const dx=m?innerWidth*.5:Math.min(innerWidth*.21,310),vis=m?1.7:2.7;
      cards.forEach((c,i)=>{
        const u=i-pos,a=Math.abs(u),op=clamp(1-(a-vis)/1.1);
        if(op<=0){c.style.visibility='hidden';return}
        c.style.visibility='visible';c.style.opacity=op.toFixed(2);
        const x=u*dx,y=Math.sin(u*.75)*-26+a*a*7,z=-a*130+(a<.6?(.6-a)*140:0);
        const ry=clamp(-u*24,-58,58),rz=u*2.2,sc=1-Math.min(a,3)*.045;
        c.style.transform=`translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,${z.toFixed(1)}px) rotateY(${ry.toFixed(1)}deg) rotateZ(${rz.toFixed(2)}deg) scale(${sc.toFixed(3)})`;
      });
      const idx=clamp(Math.round(pos),0,N-1);
      if(idx!==lastI){lastI=idx;n.textContent=String(idx+1).padStart(2,'0');t.textContent=R[idx][1];s2.textContent=R[idx][2]}
    };
    if(calm){rb.style.height='auto';draw(.5)}else reg(rb,draw,.13);
  }

  /* ---------- 3. 3D design vs final result ---------- */
  const box=$('cpBox');
  if(box){
    const rg=$('cpRange'),fin=$('cpFinal'),des=$('cpDesign');
    const setX=v=>box.style.setProperty('--x',v+'%');
    rg.addEventListener('input',()=>{touched=true;setX(rg.value)});
    let touched=false;
    $('cpTabs').addEventListener('click',e=>{
      const b=e.target.closest('button');if(!b)return;
      $('cpTabs').querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
      const src=IMG[b.dataset.k]||FALLBACK;fin.src=src;des.src=src;
      fin.alt=b.textContent+' – finished';
    });
    if(!calm){
      const io=new IntersectionObserver(es=>{
        if(!es[0].isIntersecting)return;io.disconnect();
        const t0=performance.now(),D=2600;
        (function f(n){
          if(touched)return;
          const k=clamp((n-t0)/D);
          const v=k<.45?12+(88-12)*ease(k/.45):88-(88-50)*ease((k-.45)/.55);
          rg.value=v;setX(v.toFixed(1));
          if(k<1)requestAnimationFrame(f);
        })(t0);
      },{threshold:.5});
      io.observe(box);
    }
  }

  /* ---------- 4. scroll story ---------- */
  const st=$('story');
  if(st){
    const sc=[...st.querySelectorAll('.st-s')],hs=[...st.querySelectorAll('.st-h')];
    const names=['Discover','Design','Detail','Transform'];
    const n=$('stn'),tag=$('stTag'),bar=$('stBar'),cta=$('stCta');
    let last=-1;
    const draw=p=>{
      const idx=Math.min(3,Math.floor(p*4));
      bar.style.width=(p*100).toFixed(1)+'%';
      if(idx!==last){
        last=idx;
        sc.forEach((e,i)=>e.classList.toggle('on',i===idx));
        hs.forEach((e,i)=>e.classList.toggle('on',i===idx));
        n.textContent='0'+(idx+1);tag.textContent=names[idx];
        cta.classList.toggle('on',idx===3);
      }
    };
    if(calm){st.style.height='auto';draw(0)}else reg(st,draw,.2);
  }
  kick();
})();
</script>

<script id="cine-js">
/* Scroll-linked photo transition: exterior residence expands into a finished interior. */
(function(){
  const section=document.getElementById('home');
  const exterior=document.getElementById('hjExterior');
  const interior=document.getElementById('hjInterior');
  const copyA=document.getElementById('hjCopyOne');
  const copyB=document.getElementById('hjCopyTwo');
  const label=document.getElementById('hjSceneLabel');
  const progress=document.getElementById('hjProgress');
  if(!section||!exterior||!interior)return;
  const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
  const smooth=t=>{t=clamp(t);return t*t*(3-2*t)};
  const lerp=(a,b,t)=>a+(b-a)*t;
  let raf=0;
  function draw(){
    raf=0;
    const max=Math.max(1,section.offsetHeight-innerHeight);
    const r=section.getBoundingClientRect();
    const p=clamp(-r.top/max);
    const expand=smooth(p/.42);
    const swap=smooth((p-.48)/.20);
    // Starting card dimensions are deliberately generous on small screens.
    const mobile=innerWidth<=900;
    const start=mobile?(innerWidth<=390?{l:5,t:52,w:90,h:35}:{l:5,t:50,w:90,h:36}):(innerWidth<=1100?{l:52,t:15,w:45,h:72}:{l:47,t:15,w:49,h:72});
    exterior.style.left=lerp(start.l,0,expand).toFixed(2)+'%';
    exterior.style.top=lerp(start.t,0,expand).toFixed(2)+'%';
    exterior.style.width=lerp(start.w,100,expand).toFixed(2)+'%';
    exterior.style.height=lerp(start.h,100,expand).toFixed(2)+'%';
    exterior.style.borderRadius=lerp(5,0,expand).toFixed(2)+'px';
    exterior.style.opacity=(1-swap).toFixed(3);
    exterior.style.visibility=swap>.995?'hidden':'visible';
    interior.style.opacity=swap.toFixed(3);
    interior.style.visibility=swap>.005?'visible':'hidden';
    const roomImg=interior.querySelector('img');
    if(roomImg)roomImg.style.transform='scale('+(1.06-.06*smooth((p-.52)/.48)).toFixed(3)+')';
    const a=1-smooth((p-.18)/.18);
    copyA.style.opacity=a.toFixed(3);
    copyA.style.transform='translate3d(0,'+(-22*smooth((p-.18)/.18)).toFixed(1)+'px,0)';
    copyA.style.visibility=a>.01?'visible':'hidden';
    const b=smooth((p-.64)/.16);
    copyB.style.opacity=b.toFixed(3);
    copyB.style.transform='translate3d(0,'+((1-b)*22).toFixed(1)+'px,0)';
    copyB.style.visibility=b>.01?'visible':'hidden';
