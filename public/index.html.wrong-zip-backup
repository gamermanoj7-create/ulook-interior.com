function ulookApply4KImage(img){
  if(!img || !img.getAttribute) return;
  const src=img.getAttribute('src');
  if(!src) return;
  const item=ULOOK_4K_IMAGE_MAP[src];
  if(!item){ if(img.dataset.ulook4kSrc!==src){img.removeAttribute('srcset');img.dataset.ulook4kSrc=src;} return; }
  if(img.dataset.ulook4kSrc===src) return;
  img.dataset.ulook4kSrc=src;
  img.setAttribute('srcset',src+' '+item.ow+'w, '+item.p4k+' '+item.w4k+'w');
