  /* ================= logo: metallic gold, rendered ONCE to a bitmap ================= */
  var logo=null,ctx=null;
  function renderLogo(){
    var dpr=Math.min(window.devicePixelRatio||1,2);
    var LW=Math.round(Math.min(innerWidth*.82,560));
    var FF='Outfit,Montserrat,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
    var word='ULOOK',gap=.12,i,s;
    function mk(w,h){var c=document.createElement('canvas');c.width=Math.round(w*dpr);c.height=Math.round(h*dpr);var x=c.getContext('2d');x.scale(dpr,dpr);return[c,x]}
    var m=document.createElement('canvas').getContext('2d');m.font='700 100px '+FF;
    var w100=0;for(i=0;i<word.length;i++)w100+=m.measureText(word.charAt(i)).width;w100+=gap*100*(word.length-1);
    var S=Math.min(100*LW*.9/w100,LW*.34),capH=S*.72,D=Math.max(4,S*.08),y1=S*.12+capH;
    var LH=Math.ceil(y1+D+S*.95);
    var A=mk(LW,LH),c=A[0],x=A[1];
    x.font='700 '+S+'px '+FF;x.textBaseline='alphabetic';
    var ws=[],tot=0,px=[],cx;
    for(i=0;i<word.length;i++){ws[i]=x.measureText(word.charAt(i)).width;tot+=ws[i]}
    tot+=S*gap*(word.length-1);cx=(LW-tot)/2;
    for(i=0;i<word.length;i++){px[i]=cx;cx+=ws[i]+S*gap}
    function letters(g,ox,oy){for(var k=0;k<word.length;k++)g.fillText(word.charAt(k),px[k]+ox,y1+oy)}

    /* 1) extrusion: stacked offset copies, dark bronze far -> warm gold near, one soft contact shadow */
    var steps=Math.ceil(D/.7),dx=.5,dy=.85;
    for(s=steps;s>=1;s--){
      var t=s/steps;
      x.fillStyle='rgb('+Math.round(46+122*(1-t))+','+Math.round(31+90*(1-t))+','+Math.round(7+24*(1-t))+')';
      if(s===steps){x.shadowColor='rgba(0,0,0,.6)';x.shadowBlur=16*dpr;x.shadowOffsetY=6*dpr}else{x.shadowColor='transparent';x.shadowBlur=0;x.shadowOffsetY=0}
      letters(x,dx*D*t,dy*D*t);
    }
    x.shadowColor='transparent';x.shadowBlur=0;x.shadowOffsetY=0;

    /* 2) face: gold "horizon" gradient + top gloss + diagonal sheen, clipped to the glyphs (source-atop) */
    var B=mk(LW,LH),f=B[1];f.font=x.font;f.textBaseline='alphabetic';
    var fg=f.createLinearGradient(0,y1-capH,0,y1);
    [[0,'#fff6cf'],[.14,'#f9dc7f'],[.34,'#d9a93a'],[.47,'#9c6f14'],[.52,'#f3d478'],[.70,'#c9962b'],[.88,'#8e6314'],[1,'#e9c15a']].forEach(function(p){fg.addColorStop(p[0],p[1])});
    f.fillStyle=fg;letters(f,0,0);
    f.globalCompositeOperation='source-atop';
    var gl=f.createLinearGradient(0,y1-capH,0,y1-capH*.45);gl.addColorStop(0,'rgba(255,255,255,.38)');gl.addColorStop(1,'rgba(255,255,255,0)');
    f.fillStyle=gl;f.fillRect(0,y1-capH,LW,capH*.55);
    var dg=f.createLinearGradient(0,0,LW,LH*.6);dg.addColorStop(0,'rgba(255,255,255,0)');dg.addColorStop(.42,'rgba(255,255,255,0)');dg.addColorStop(.5,'rgba(255,250,225,.2)');dg.addColorStop(.58,'rgba(255,255,255,0)');dg.addColorStop(1,'rgba(255,255,255,0)');
    f.fillStyle=dg;f.fillRect(0,0,LW,LH);
    f.globalCompositeOperation='source-over';
    /* bevel: glyph minus shifted glyph = thin lit rim top-left, dark rim bottom-right */
    function rim(ox,oy,col){var R=mk(LW,LH),r=R[1];r.font=x.font;r.textBaseline='alphabetic';r.fillStyle=col;letters(r,0,0);r.globalCompositeOperation='destination-out';r.fillStyle='#000';letters(r,ox,oy);f.drawImage(R[0],0,0,LW,LH)}
    rim(1.1,1.1,'rgba(255,248,215,.75)');rim(-1.1,-1.1,'rgba(70,44,6,.55)');
    x.drawImage(B[0],0,0,LW,LH);

    /* 3) floor reflection: mirrored copy faded out quickly */
    var mid=y1+D*.85+S*.04,C=mk(LW,LH),rx=C[1];
    rx.save();rx.translate(0,2*mid);rx.scale(1,-1);rx.drawImage(c,0,0,LW,LH);rx.restore();
    rx.globalCompositeOperation='destination-in';
    var rg=rx.createLinearGradient(0,mid,0,mid+S*.45);rg.addColorStop(0,'rgba(0,0,0,.3)');rg.addColorStop(1,'rgba(0,0,0,0)');
    rx.fillStyle=rg;rx.fillRect(0,0,LW,LH);rx.globalCompositeOperation='source-over';rx.clearRect(0,0,LW,mid);
    x.drawImage(C[0],0,0,LW,LH);

    /* 4) INTERIOR: thin, wide-tracked champagne line */
    var fs=S*.19,sp=fs*.62,w2='INTERIOR',yy=y1+D+S*.78;
    x.font='300 '+fs+'px '+FF;
    var tw=0;for(i=0;i<w2.length;i++)tw+=x.measureText(w2.charAt(i)).width;tw+=sp*(w2.length-1);
    var ig=x.createLinearGradient(0,yy-fs,0,yy);ig.addColorStop(0,'#f1e2b3');ig.addColorStop(1,'#b8985a');x.fillStyle=ig;
    var ix=(LW-tw)/2;for(i=0;i<w2.length;i++){x.fillText(w2.charAt(i),ix,yy);ix+=x.measureText(w2.charAt(i)).width+sp}

    return{c:c,LW:LW,LH:LH,dpr:dpr,faceY:y1-capH*.5};
  }
  function frame(gx){            /* base bitmap + optional moving specular glint (source-atop => only on gold) */
    ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,cv.width,cv.height);ctx.drawImage(logo.c,0,0);
    if(gx!=null){
      ctx.globalCompositeOperation='source-atop';
      var bw=logo.LW*.16*logo.dpr,X=gx*logo.dpr,g=ctx.createLinearGradient(X-bw,0,X+bw,bw*.7);
      g.addColorStop(0,'rgba(255,250,228,0)');g.addColorStop(.5,'rgba(255,250,228,.55)');g.addColorStop(1,'rgba(255,250,228,0)');
      ctx.fillStyle=g;ctx.fillRect(0,0,cv.width,cv.height);ctx.globalCompositeOperation='source-over';
    }
  }
  function sweep(){
    var t1=performance.now();
    (function f(n){
      if(done||phase>0)return;
      var k=Math.max(0,Math.min(1,(n-t1)/950)),e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
      frame(-logo.LW*.2+e*logo.LW*1.4);
      if(k<1)raf=requestAnimationFrame(f);else frame(null);
    })(t1);
  }
  function probe(){               /* cheap main-thread health check: slow device => lighter shatter, no glint */
    var last=0,n=0,sum=0;
    (function f(t){if(done||phase>0)return;if(last){sum+=t-last;n++}last=t;if(n<14)raf2=requestAnimationFrame(f);else lite=(sum/n)>30})(performance.now());
  }

  /* ================= glass geometry (see test notes: covers the screen exactly) ================= */
  /* geometry */
  function clipRect(p,W,H){
    function cl(p,inside,inter){var o=[];for(var i=0;i<p.length;i++){var a=p[i],b=p[(i+1)%p.length],ia=inside(a),ib=inside(b);if(ia){o.push(a);if(!ib)o.push(inter(a,b))}else if(ib){o.push(inter(a,b))}}return o}
    p=cl(p,function(q){return q[0]>=0},function(a,b){var t=(0-a[0])/(b[0]-a[0]);return[0,a[1]+t*(b[1]-a[1])]});if(!p.length)return p;
    p=cl(p,function(q){return q[0]<=W},function(a,b){var t=(W-a[0])/(b[0]-a[0]);return[W,a[1]+t*(b[1]-a[1])]});if(!p.length)return p;
    p=cl(p,function(q){return q[1]>=0},function(a,b){var t=(0-a[1])/(b[1]-a[1]);return[a[0]+t*(b[0]-a[0]),0]});if(!p.length)return p;
    return cl(p,function(q){return q[1]<=H},function(a,b){var t=(H-a[1])/(b[1]-a[1]);return[a[0]+t*(b[0]-a[0]),H]});
  }
  function area(p){var s=0;for(var i=0;i<p.length;i++){var a=p[i],b=p[(i+1)%p.length];s+=a[0]*b[1]-b[0]*a[1]}return Math.abs(s)/2}
  function makeGeometry(W,H,cx,cy,N,R,rand){
    var D=Math.hypot(W,H),K=R.length,V=[],rayA=[],a0=rand()*6.2832,i,k;
    for(i=0;i<N;i++)rayA[i]=a0+(i+(rand()-.5)*.55)/N*6.2832;
    for(k=0;k<K;k++){V[k]=[];for(i=0;i<N;i++){
      if(k===0){V[0][i]=[cx,cy];continue}
      var ang=rayA[i]+(rand()-.5)*(6.2832/N)*.18,rr=R[k]*D*(k===K-1?1+rand()*.1:1+(rand()-.5)*.26);
      V[k][i]=[cx+Math.cos(ang)*rr,cy+Math.sin(ang)*rr];
    }}
    var cells=[];
    for(k=1;k<K;k++)for(i=0;i<N;i++){
      var j=(i+1)%N;
      if(k===1){cells.push([V[0][0],V[1][i],V[1][j]]);continue}
      var A=V[k-1][i],B=V[k][i],C=V[k][j],E=V[k-1][j];
      if(k>=3&&rand()<.5){if(rand()<.5){cells.push([A,B,C]);cells.push([A,C,E])}else{cells.push([A,B,E]);cells.push([B,C,E])}}
      else cells.push([A,B,C,E]);
    }
    var out=[];cells.forEach(function(c){var p=clipRect(c,W,H);if(p.length>=3&&area(p)>30)out.push(p)});
    return{cells:out,D:D};
  }
  /* end geometry */

  /* ================= phase 1: cracks spread from the impact point ================= */
  var geo=null,imp=null,metas=[];
  function crack(){
    if(phase>0||done)return;phase=1;
    try{
      var W=intro.clientWidth,H=intro.clientHeight,r=cv.getBoundingClientRect();
      var cx=r.left+r.width/2+(Math.random()-.5)*r.width*.12,cy=r.top+logo.faceY+(Math.random()-.5)*logo.faceY*.25;
      imp={x:cx,y:cy,W:W,H:H};
      var N=lite?7:(W<700?10:12),R=lite?[0,.1,.26,.52,.9]:[0,.07,.16,.30,.52,.85];
      geo=makeGeometry(W,H,cx,cy,N,R,Math.random);
      var html='',rnd=Math.random;
      geo.cells.forEach(function(p){
        var sx=0,sy=0,x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
        p.forEach(function(v){sx+=v[0];sy+=v[1];x0=Math.min(x0,v[0]);y0=Math.min(y0,v[1]);x1=Math.max(x1,v[0]);y1=Math.max(y1,v[1])});
        sx/=p.length;sy/=p.length;
        var bx=Math.floor(x0)-1,by=Math.floor(y0)-1,bw=Math.ceil(x1)-bx+1,bh=Math.ceil(y1)-by+1;
        var pts=p.map(function(v){return(v[0]-bx).toFixed(1)+','+(v[1]-by).toFixed(1)}).join(' ');
        /* crack lines = shard edges, except edges lying on the screen border */
        var d='',ei,ea,eb;
        for(ei=0;ei<p.length;ei++){ea=p[ei];eb=p[(ei+1)%p.length];
          if((ea[0]<.5&&eb[0]<.5)||(ea[0]>W-.5&&eb[0]>W-.5)||(ea[1]<.5&&eb[1]<.5)||(ea[1]>H-.5&&eb[1]>H-.5))continue;
          d+='M'+(ea[0]-bx).toFixed(1)+' '+(ea[1]-by).toFixed(1)+'L'+(eb[0]-bx).toFixed(1)+' '+(eb[1]-by).toFixed(1)}
        var hair='',ar=area(p),nh=lite?0:(ar>9000?2:(ar>1200&&rnd()<.6?1:0)),hi;   /* hairline cracks inside bigger shards */
        for(hi=0;hi<nh;hi++){
          var e=Math.floor(rnd()*p.length),a=p[e],b=p[(e+1)%p.length],tt=.25+rnd()*.5,mx=a[0]+(b[0]-a[0])*tt,my=a[1]+(b[1]-a[1])*tt,k2=.3+rnd()*.3;
          hair+='M'+(mx-bx).toFixed(1)+' '+(my-by).toFixed(1)+'L'+(mx+(sx-mx)*k2-bx).toFixed(1)+' '+(my+(sy-my)*k2-by).toFixed(1);
        }
        html+='<svg class="gs" style="left:'+bx+'px;top:'+by+'px" width="'+bw+'" height="'+bh+'" viewBox="0 0 '+bw+' '+bh+'">'+
          '<polygon points="'+pts+'" fill="url(#igg'+Math.floor(rnd()*3)+')"/>'+
          '<path d="'+d+'" fill="none" stroke="rgba(250,246,241,'+(.24+rnd()*.26).toFixed(2)+')" stroke-width=".8" stroke-linecap="round"/>'+
          (hair?'<path d="'+hair+'" fill="none" stroke="rgba(250,246,241,.22)" stroke-width=".5" stroke-linecap="round"/>':'')+'</svg>';
        metas.push([sx,sy]);
      });
      pane.innerHTML=html;                                   /* one DOM write for all shards */
      pane.style.transformOrigin=cx+'px '+cy+'px';
      glass.style.perspective='800px';glass.style.perspectiveOrigin=cx+'px '+cy+'px';
      flash.style.left=cx+'px';flash.style.top=cy+'px';

      an(pane,[{opacity:0,transform:'scale(.12)',offset:0},{opacity:1,offset:.35},{opacity:1,transform:'scale(1)',offset:1}],{duration:650,easing:'cubic-bezier(.12,.7,.2,1)',fill:'forwards'});
      an(flash,[{opacity:0,transform:'scale(.5)'},{opacity:1,transform:'scale(1)',offset:.25},{opacity:0,transform:'scale(1.4)'}],{duration:520,easing:'ease-out'});
      an(cv,[{transform:'perspective(900px) translate(0,0)'},{transform:'perspective(900px) translate(-2px,1.5px)'},{transform:'perspective(900px) translate(1.5px,-1px)'},{transform:'perspective(900px) translate(0,0)'}],{duration:240});
      at(650,shatter);
    }catch(e){finish()}
  }

  /* ================= phase 2: fragments rush toward the camera, logo passes through, homepage is revealed ================= */
  function shatter(){
    if(phase>1||done)return;phase=2;
    try{
      intro.classList.add('out');
      var shards=[].slice.call(pane.querySelectorAll('.gs')),half=geo.D*.5,maxEnd=0,rd=Math.random;
      shards.forEach(function(s){glass.appendChild(s)});     /* pane is at scale(1) now: move shards under the perspective container (no visual change) */
      pane.parentNode.removeChild(pane);
      shards.forEach(function(s,n){
        var m=metas[n],dx=m[0]-imp.x,dy=m[1]-imp.y,dist=Math.hypot(dx,dy)||1,kx=dx/dist,ky=dy/dist,nn=Math.min(1,dist/half);
        var delay=nn*220+rd()*60,dur=1100+rd()*400;
        var push=(50+rd()*110)*(1.3-.6*nn),z=Math.min(640,(330+rd()*260)*(1.15-.35*nn)),fall=90+rd()*170;
        var rx=(rd()-.5)*2*(30+rd()*80),ry=(rd()-.5)*2*(30+rd()*80),rz=(rd()-.5)*2*(20+rd()*50);
        an(s,[
          {transform:'translate3d(0,0,0) rotateX(0) rotateY(0) rotateZ(0)',opacity:1,offset:0},
          {opacity:1,offset:.5},
          {transform:'translate3d('+(kx*push)+'px,'+(ky*push+fall)+'px,'+z+'px) rotateX('+rx+'deg) rotateY('+ry+'deg) rotateZ('+rz+'deg)',opacity:0,offset:1}
        ],{duration:dur,delay:delay,easing:'cubic-bezier(.3,.05,.4,1)',fill:'forwards'});
        maxEnd=Math.max(maxEnd,delay+dur);
      });
      an(cv,[{transform:'perspective(900px) translate3d(0,0,0)',opacity:1},{transform:'perspective(900px) translate3d(0,0,520px)',opacity:0}],{duration:950,easing:'cubic-bezier(.5,0,.9,.6)',fill:'forwards'});
      an(tag,[{opacity:1},{opacity:0}],{duration:300,fill:'forwards'});
      an(q('.is'),[{opacity:1},{opacity:0}],{duration:200,fill:'forwards'});
      an(bg,[{opacity:1},{opacity:0}],{duration:950,delay:260,easing:'cubic-bezier(.4,0,.2,1)',fill:'forwards'});
      at(Math.max(maxEnd,1210)+120,finish);
    }catch(e){finish()}
  }

  /* ================= timeline ================= */
  function start(){
    if(done)return;
    try{
      logo=renderLogo();
      cv.width=logo.c.width;cv.height=logo.c.height;cv.style.width=logo.LW+'px';cv.style.height=logo.LH+'px';
      ctx=cv.getContext('2d');frame(null);
    }catch(e){finish();return}
    if(reduce){                                              /* reduced motion: static logo, short fade, no shatter */
      cv.style.opacity=1;cv.style.transform='none';tag.style.opacity=1;at(900,skip);return;
    }
    an(cv,[{transform:'perspective(900px) translate3d(0,0,-560px) rotateX(9deg) rotateY(-13deg)'},{transform:'perspective(900px) translate3d(0,0,0) rotateX(0) rotateY(0)'}],{duration:2500,easing:'cubic-bezier(.14,.8,.22,1)',fill:'forwards'});
    an(cv,[{opacity:0},{opacity:1}],{duration:1300,easing:'cubic-bezier(.3,.1,.3,1)',fill:'forwards'});
    an(tag,[{opacity:0,transform:'translateY(8px)'},{opacity:1,transform:'none'}],{duration:900,delay:1500,easing:'ease-out',fill:'forwards'});
    at(300,probe);
    at(1450,function(){if(!lite&&phase===0)sweep()});
    at(2650,crack);
  }
  var fonts=(document.fonts&&document.fonts.load)?Promise.all([document.fonts.load('700 100px Outfit'),document.fonts.load('300 40px Outfit')]).catch(function(){}):Promise.resolve();
  Promise.race([fonts,new Promise(function(r){setTimeout(r,1400)})]).then(start);
})();
</script>


