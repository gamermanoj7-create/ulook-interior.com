<style>
:root{--paper:#f7f3ee;--card:#fff;--ink:#251f17;--muted:#766e64;--line:rgba(37,31,23,.12);--blue:#a57d4c;--sky:#dbccba;--navy:#483621;--r:26px;--gold:#c9a96a;--ivory:#f9f6f2}
*{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:clip}body{overflow-x:clip}
body{margin:0;background:var(--ivory);color:var(--ink);font-family:"Outfit",system-ui,sans-serif;font-weight:400;line-height:1.55;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.wrap{width:min(1180px,92%);margin:auto}
h1,h2,h3,p{margin-top:0}
h2{font-size:clamp(36px,5.2vw,64px);line-height:1.02;letter-spacing:-.035em;font-weight:500;margin-bottom:0}
.kicker{font-size:12px;color:var(--muted);letter-spacing:.04em;margin-bottom:14px}
.pill{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:99px;font-size:14px;font-weight:500;border:1px solid var(--ink);background:var(--ink);color:#fff;cursor:pointer;transition:transform .2s,background .2s}
.pill:hover{transform:translateY(-2px)}
.pill.white{background:#fff;color:var(--ink);border-color:#fff}
.pill.ghost{background:transparent;color:inherit;border-color:currentColor;opacity:.9}
.link{font-size:13px;border-bottom:1px solid currentColor;padding-bottom:2px;white-space:nowrap}

/* NAV */
.nav{position:fixed;z-index:50;top:16px;left:0;right:0;margin:0 auto;width:min(1240px,94%);display:flex;align-items:center;justify-content:space-between;color:#fff;transition:color .3s}
.nav.solid{color:var(--ink)}
.logo{font-weight:600;font-size:18px;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}
.logo i{font-style:normal;display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:currentColor}
.logo i b{color:var(--navy);font-size:15px}
.nav.solid .logo i b{color:#fff}
.links{display:flex;gap:4px;padding:6px;border-radius:99px;background:rgba(255,255,255,.14);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.18);font-size:13px}
.nav.solid .links{background:rgba(255,255,255,.85);border-color:var(--line)}
.links a{padding:8px 16px;border-radius:99px;transition:background .2s}.links a:hover{background:rgba(127,127,127,.18)}
.nav .pill{padding:10px 18px;font-size:13px;background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3);color:inherit;backdrop-filter:blur(14px)}
.nav.solid .pill{background:var(--ink);color:#fff;border-color:var(--ink)}
.burger{display:none;background:none;border:0;font-size:26px;color:inherit}

/* HERO */
.hero{position:relative;height:100svh;min-height:640px;overflow:hidden;color:#fff;background:var(--navy);transition:background .9s ease}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 55% 60% at 50% 55%,rgba(255,255,255,.2),transparent 70%)}
.hero-grid{position:relative;height:100%;width:min(1240px,94%);margin:auto;display:grid;grid-template-columns:1fr 1.1fr 1fr;align-items:center;padding-top:60px}
.hero-copy{max-width:380px}
.hero-copy h1{font-size:clamp(40px,5vw,72px);line-height:1;letter-spacing:-.04em;font-weight:500;margin-bottom:20px}
.hero-copy p{font-size:15px;opacity:.8;max-width:330px}
.hero-copy .row{display:flex;gap:10px;margin-top:26px;flex-wrap:wrap}
.slider-ctrl{display:flex;align-items:center;gap:12px;margin-bottom:34px;font-size:12px;opacity:.9}
.arrow{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:transparent;color:#fff;cursor:pointer;display:grid;place-items:center;transition:background .2s}
.arrow:hover{background:rgba(255,255,255,.2)}
.bar{width:48px;height:1px;background:rgba(255,255,255,.3);position:relative}.bar i{position:absolute;left:0;top:0;height:1px;background:#fff;width:0}
.stage{position:relative;height:min(68vh,560px);display:grid;place-items:center}
.stage .arch{position:absolute;width:min(380px,100%);aspect-ratio:3/4;border-radius:999px 999px 28px 28px;overflow:hidden;box-shadow:0 40px 80px -20px rgba(0,0,0,.55);transition:opacity .6s,transform .8s cubic-bezier(.2,.7,.2,1)}
.stage .arch img{width:100%;height:100%;object-fit:cover}
.stage .arch.out{opacity:0;transform:translateY(24px) scale(.96)}
.next-thumb{position:absolute;right:-6%;bottom:6%;width:92px;aspect-ratio:3/4;border-radius:40px 40px 14px 14px;overflow:hidden;border:2px solid rgba(255,255,255,.4);cursor:pointer;box-shadow:0 14px 30px rgba(0,0,0,.35)}
.next-thumb img{width:100%;height:100%;object-fit:cover}
.hero-meta{justify-self:end;text-align:right;align-self:end;padding-bottom:12vh;font-size:14px;opacity:.85}
.hero-meta b{display:block;font-weight:500;font-size:22px;line-height:1.15;letter-spacing:-.02em}
.badge{position:absolute;left:3%;bottom:7%;width:112px;height:112px}
.badge svg{width:100%;height:100%;animation:spin 18s linear infinite}
.badge span{position:absolute;inset:0;display:grid;place-items:center;font-weight:700;font-size:22px}
@keyframes spin{to{transform:rotate(360deg)}}
.socials{position:absolute;left:3%;bottom:30px;display:flex;gap:8px}
.socials a{width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,.35);display:grid;place-items:center;font-size:11px}
.tag{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);font-size:13px;text-align:center;opacity:.85}

/* SECTIONS */
section{padding:clamp(70px,9vw,130px) 0}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:46px}
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.cat{position:relative;aspect-ratio:1/1.05;border-radius:var(--r);overflow:hidden;color:#fff;background:#2f261b;isolation:isolate}
.cat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.cat::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(to top,rgba(24,19,12,.78),transparent 55%)}
.cat:hover img{transform:scale(1.06)}
.cat small{position:absolute;top:16px;left:18px;font-size:11px;opacity:.8}
.cat .go{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.22);backdrop-filter:blur(8px);display:grid;place-items:center;font-size:13px}
.cat div{position:absolute;left:20px;right:20px;bottom:18px}
.cat h3{font-size:24px;font-weight:500;letter-spacing:-.02em;margin:0 0 2px}.cat p{font-size:13px;opacity:.8;margin:0}

.rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 4% 20px;scrollbar-width:none}
.rail::-webkit-scrollbar{display:none}
.proj{flex:0 0 min(300px,72vw);scroll-snap-align:start}
.proj .ph{aspect-ratio:3/4;border-radius:var(--r);overflow:hidden;background:#ede5dc;position:relative}
.proj .ph img{width:100%;height:100%;object-fit:cover;transition:transform .8s}
.proj:hover .ph img{transform:scale(1.05)}
.proj .ph span{position:absolute;top:14px;left:14px;font-size:11px;background:rgba(255,255,255,.9);padding:4px 10px;border-radius:99px}
.proj .row{display:flex;justify-content:space-between;align-items:center;padding:14px 4px}
.proj h3{font-size:16px;font-weight:500;margin:0}.proj small{color:var(--muted);font-size:12px}
.proj .cart{width:34px;height:34px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:13px}
.railnav{display:flex;gap:8px;justify-content:flex-end;width:min(1180px,92%);margin:0 auto}
.railnav .arrow{border-color:var(--line);color:var(--ink)}.railnav .arrow.on{background:var(--ink);color:#fff}

.custom{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}
.pics{position:relative}
.pics .big{border-radius:var(--r);overflow:hidden;aspect-ratio:4/5;background:#2f261b}
.pics .big img,.pics .small img{width:100%;height:100%;object-fit:cover}
.pics .small{position:absolute;right:-5%;bottom:-5%;width:36%;aspect-ratio:1;border-radius:var(--r);overflow:hidden;border:6px solid var(--paper)}
.custom h2{margin-bottom:22px}
.custom .lead{color:var(--muted);max-width:430px;margin-bottom:26px}
.feat{border-top:1px solid var(--line);padding:16px 0;display:grid;grid-template-columns:28px 1fr;gap:14px}
.feat:last-of-type{border-bottom:1px solid var(--line);margin-bottom:22px}
.feat b{font-weight:500;font-size:15px;display:block}.feat span{font-size:13px;color:var(--muted)}
.feat i{font-style:normal;font-size:17px;color:var(--blue)}

.process-box{background:#f1eae1;border-radius:34px;padding:clamp(28px,5vw,60px)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;margin-top:50px}
.step{border-top:1px solid var(--ink);padding-top:14px}
.step small{color:var(--muted);font-size:12px}.step h3{font-size:20px;font-weight:500;margin:6px 0}.step p{font-size:13px;color:var(--muted);margin:0}

.dark{background:#1c1812;color:#fff;padding-top:130px}
.dark .kicker{color:rgba(255,255,255,.6)}
.dark .head{align-items:flex-end}
.panels{display:flex;height:min(62vh,520px);gap:0;border-radius:0;overflow:hidden}
.panel{flex:1;position:relative;overflow:hidden;cursor:pointer;transition:flex .7s cubic-bezier(.2,.7,.2,1);border-right:1px solid #1c1812}
.panel img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.85) brightness(.75);transition:filter .6s,transform .8s}
.panel.active{flex:2.6}.panel.active img{filter:none}
.panel div{position:absolute;left:0;right:0;bottom:0;padding:22px;background:linear-gradient(to top,rgba(0,0,0,.75),transparent);opacity:0;transition:opacity .5s}
.panel.active div{opacity:1}
.panel h3{font-size:20px;font-weight:500;margin:0}.panel small{opacity:.7;font-size:12px}

.mosaic{display:grid;grid-template-columns:1.12fr 1fr 1fr 1.12fr;gap:14px;align-items:stretch;margin:0 auto 48px;overflow:visible;max-width:1120px}
.mosaic img{width:100%;height:270px;object-fit:cover;border-radius:22px;box-shadow:0 22px 46px -26px rgba(26,21,14,.5);border:1px solid rgba(201,169,106,.35);transition:transform .6s,box-shadow .6s}
.mosaic img:nth-child(even){transform:translateY(18px)}
.mosaic img:hover{transform:translateY(-5px) scale(1.015);box-shadow:0 30px 58px -28px rgba(26,21,14,.62)}
.trust{text-align:center}
.trust h2{font-size:clamp(38px,5.4vw,66px);letter-spacing:-.025em}.trust h2 span{color:var(--gold);font-style:italic}.trust .mosaic+ h2{margin-top:4px}
.promise{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:56px;text-align:left}
.promise div{border-top:1px solid rgba(201,169,106,.58);padding-top:16px;font-size:14px;color:var(--muted)}.promise b{display:block;color:var(--ink);font-weight:500;margin-bottom:4px}

.faq{display:grid;grid-template-columns:1fr 1.4fr;gap:60px}
.faq p.s{color:var(--muted);font-size:14px;max-width:300px;margin:18px 0}
details{border-bottom:1px solid var(--line);padding:18px 0}
summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-size:16px;font-weight:500}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";width:28px;height:28px;border-radius:50%;background:#f1eae1;display:grid;place-items:center;flex:none;transition:transform .3s,background .3s}
details[open] summary::after{content:"–";background:var(--ink);color:#fff}
details p{color:var(--muted);font-size:14px;margin:12px 0 0;max-width:520px}

.contact{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(30px,6vw,80px)}
.contact .info{margin-top:28px;display:grid;gap:16px;font-size:14px}.info b{display:block;font-weight:500}.info span{color:var(--muted)}
.form{background:#fff;border-radius:var(--r);padding:clamp(22px,3vw,36px);display:grid;grid-template-columns:1fr 1fr;gap:16px;border:1px solid var(--line)}
.form label{font-size:12px;color:var(--muted);display:grid;gap:6px}.form .full{grid-column:1/-1}
.form input,.form select,.form textarea{padding:13px 14px;border:1px solid var(--line);border-radius:14px;background:var(--paper);font-size:14px}
.form textarea{min-height:100px;resize:vertical}
.note{font-size:11px;color:var(--muted)}

.cta{margin:0 auto;width:min(1240px,96%);border-radius:34px;background:radial-gradient(ellipse 70% 80% at 50% 0%,#55432d,#18140f 70%);color:#fff;text-align:center;padding:clamp(60px,8vw,110px) 20px 0;overflow:hidden}
.cta h2{max-width:760px;margin:0 auto 18px}.cta p{opacity:.7;max-width:420px;margin:0 auto 28px;font-size:15px}
.cta .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.cta .fan{display:flex;justify-content:center;align-items:flex-end;gap:0;margin-top:60px;height:190px}
.cta .fan img{width:min(170px,22vw);aspect-ratio:3/4;object-fit:cover;border-radius:999px 999px 0 0;margin:0 -10px;box-shadow:0 -10px 30px rgba(0,0,0,.4)}
.cta .fan img:nth-child(odd){transform:translateY(34px)}
footer{position:relative;margin-top:70px;padding:76px 0 30px;overflow:hidden;background:linear-gradient(145deg,#1c160f 0%,#382d1f 58%,#201911 100%);color:#fff;border-top:1px solid rgba(201,169,106,.45)}
.foot{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;font-size:13px}
.foot p{color:rgba(255,255,255,.66);max-width:280px;margin-top:12px}
.foot h4{font-weight:400;color:var(--gold);font-size:11px;margin:0 0 12px;letter-spacing:.18em;text-transform:uppercase}
.foot a{display:block;margin-bottom:9px;color:rgba(255,255,255,.9);transition:color .2s}.foot a:hover{color:var(--gold)}
.copy{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:11px;color:rgba(255,255,255,.58);margin-top:46px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12)}
.giant{display:block;width:100%;font-size:clamp(54px,12.4vw,176px);font-weight:500;letter-spacing:-.065em;line-height:.78;text-align:center;margin:48px auto 0;white-space:normal;overflow-wrap:anywhere;word-break:normal;transform:none;background:linear-gradient(110deg,#fff 0%,#d6bd8b 45%,#b9a996 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.giant span{display:block;font-size:.48em;letter-spacing:.22em;line-height:1.1;margin-top:14px;color:#d6bd8b}
.wa{position:fixed;right:18px;bottom:18px;z-index:60;background:#25d366;color:#052e16;padding:12px 18px;border-radius:99px;font-weight:600;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.25)}

@media(max-width:900px){
 .links,.nav>.pill{display:none}.burger{display:block}
 .nav.open .links{display:flex;position:absolute;top:50px;right:0;flex-direction:column;border-radius:22px;background:rgba(56,44,29,.95);color:#fff}
 .hero-grid{grid-template-columns:1fr;grid-template-rows:auto 1fr;padding-top:84px;text-align:left}
 .hero-copy h1{font-size:44px}.hero-copy p{display:none}.slider-ctrl{margin-bottom:18px}.hero-copy .row{margin-top:14px}
 .hero-meta,.socials{display:none}.stage{height:100%}.stage .arch{width:min(240px,62vw)}
 .badge{width:84px;height:84px;left:auto;right:14px;top:84px;bottom:auto}
 .cats{grid-template-columns:1fr 1fr}.custom,.faq,.contact{grid-template-columns:1fr}
 .steps{grid-template-columns:1fr 1fr}.promise{grid-template-columns:1fr}.foot{grid-template-columns:1fr 1fr}
 .head{flex-direction:column;align-items:flex-start}.panels{height:60vh;flex-direction:column}.panel.active{flex:3}
 .pics .small{right:0}.form{grid-template-columns:1fr}.mosaic img:nth-child(n+6){display:none}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* LUXE LAYER */
.serif{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;letter-spacing:-.01em}
.pill{letter-spacing:.02em}.pill:hover{background:#4e3f2c;border-color:var(--gold)}.pill.white:hover{background:var(--gold);border-color:var(--gold);color:#fff}

.hero::after{content:"";position:absolute;inset:14px;border:1px solid rgba(201,169,106,.35);border-radius:22px;pointer-events:none}
.hero-copy .eyebrow{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
.hero-copy .eyebrow::before{content:"";width:34px;height:1px;background:var(--gold)}
.hero-copy h1{font-family:"Cormorant Garamond",serif;font-weight:500;font-size:clamp(46px,5.6vw,84px);line-height:.98;letter-spacing:-.02em}
.stage .arch{box-shadow:0 50px 90px -20px rgba(0,0,0,.6),0 0 0 1px rgba(201,169,106,.5),0 0 0 10px rgba(255,255,255,.05)}
h2{font-family:"Cormorant Garamond",serif;font-weight:500;letter-spacing:-.02em;font-size:clamp(42px,6vw,78px);line-height:.98}
h2 em{font-style:italic;color:var(--blue)}
.dark h2 em,.cta h2 em,.qband h2 em{color:var(--gold)}
.kicker{text-transform:uppercase;letter-spacing:.24em;font-size:11px;color:var(--gold)}
.dark .kicker{color:var(--gold)}
.cat,.proj .ph,.pics .big{box-shadow:0 30px 60px -30px rgba(37,31,23,.4)}
.marq{background:#1f1911;color:var(--gold);overflow:hidden;white-space:nowrap;padding:18px 0;border-top:1px solid rgba(201,169,106,.3);border-bottom:1px solid rgba(201,169,106,.3)}
.marq div{display:inline-flex;gap:46px;animation:mq 32s linear infinite;font-family:"Cormorant Garamond",serif;font-size:26px;font-style:italic}
.marq span:nth-child(even){font-style:normal;font-size:14px;align-self:center}
@keyframes mq{to{transform:translateX(-50%)}}
.quality{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}
.qphotos{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.qphotos img{width:100%;object-fit:cover;border-radius:var(--r)}
.qphotos img:nth-child(1){aspect-ratio:3/4.4;height:100%;grid-row:span 2}
.qphotos img:nth-child(2){aspect-ratio:1/1.1;margin-top:40px}
.qphotos img:nth-child(3){aspect-ratio:1/1.1}
.quality .lead{color:var(--muted);max-width:440px;margin:22px 0 28px}
.qlist div{display:flex;gap:18px;padding:16px 0;border-top:1px solid rgba(201,169,106,.5);align-items:baseline}
.qlist div:last-child{border-bottom:1px solid rgba(201,169,106,.5)}
.qlist b{font-family:"Cormorant Garamond",serif;font-size:24px;font-weight:500;min-width:150px}.qlist span{font-size:13px;color:var(--muted)}
.qband{position:relative;min-height:80vh;display:grid;place-items:center;text-align:center;color:#fff;overflow:hidden;isolation:isolate}
.qband>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
