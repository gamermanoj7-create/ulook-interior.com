/* 3D walkthrough: scroll moves the camera down a gallery corridor */
(function(){
  const sec=document.getElementById('walk'),scene=document.getElementById('scene'),lab=document.getElementById('wlabel'),wn=document.getElementById('wn');
  const F=[['B','Interior'],['J','Modular kitchen'],['K','Bedroom'],['I','Interior'],['H','Lounge'],['L','Interior'],['G','Kitchen detail'],['M','Interior']];
  const GAP=720,N=F.length;
  scene.innerHTML=F.map((f,i)=>`<figure class="wf${i===N-1?' c':''}" data-i="${i}"><div class="in"><img data-k="${f[0]}" alt="${f[1]}"></div><figcaption>${f[1]}</figcaption></figure>`).join('');
  const fr=[...scene.children];
  fr.forEach(el=>{const im=el.querySelector('img');fb(im);im.src=IMG[im.dataset.k]||FALLBACK;im.loading='eager';im.decoding='async'});
  let sm=0,target=0,raf,inview=false,running=false,kick=0;
  function layout(){
    const mob=innerWidth<900,x=mob?innerWidth*.34:Math.min(innerWidth*.27,420),rot=mob?22:34;
    fr.forEach((el,i)=>{
      const side=i%2?1:-1,last=i===N-1;
      el._z=-(i*GAP)-560;el._x=last?0:side*x;el._r=last?0:-side*rot;
    });
  }
  layout();addEventListener('resize',layout);
  function frame(){
    running=true;
    const r=sec.getBoundingClientRect(),max=sec.offsetHeight-innerHeight;
    target=Math.min(1,Math.max(0,-r.top/max));
    sm+=(target-sm)*.14;
    const cam=sm*(N-1)*GAP;
    scene.style.transform=`translateZ(${cam}px)`;
    let best=0,bd=1e9;
    fr.forEach((el,i)=>{
      const dz=el._z+cam;                 // distance from camera plane
      const ph=Math.min(1,Math.max(0,(dz+560)/360)),near=1-ph*ph*(3-2*ph);
      const far=innerWidth<900?Math.min(1,Math.max(0,1-(-dz-1450)/1000)):Math.min(1,Math.max(0,1-(-dz-2300)/1500));
      const fs=far*far*(3-2*far),op=near*fs;el.style.opacity=op.toFixed(3);el.style.visibility=op>.01?'visible':'hidden';
      el.style.transform=`translate3d(${(el._x*(1+ph*1.4)).toFixed(1)}px,0,${el._z}px) rotateY(${el._r}deg)`;
      el.style.pointerEvents='none';
      const d=Math.abs(dz+560);if(d<bd){bd=d;best=i}
    });
    lab.textContent=F[best][1];wn.textContent=String(best+1).padStart(2,'0');
    document.querySelector('.walk-title').style.opacity=sm<.06?1:0;
    if(inview&&(Math.abs(target-sm)>.0004||kick-->0))raf=requestAnimationFrame(frame);else running=false;
  }
  const io2=new IntersectionObserver(es=>{es.forEach(e=>{inview=e.isIntersecting;cancelAnimationFrame(raf);running=false;if(inview){kick=8;frame()}})},{rootMargin:'200px'});
  io2.observe(sec);
  addEventListener('scroll',()=>{if(inview&&!running){kick=8;frame()}},{passive:true});
  addEventListener('resize',()=>{kick=8;if(inview&&!running)frame()});
})();

